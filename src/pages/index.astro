---
layout: '../layouts/BaseLayout.astro'
title: "Home"
---

---
const findings = [
  { title: 'OpenAI GPT-4o Mini', date: '2026-09-16', category: 'AI', tags: ['ai', 'openai'] },
  { title: 'Local AI with Ollama', date: '2026-09-15', category: 'AI', tags: ['ai', 'local'] },
];

const projects = [
  { title: 'NEXUS - Personal Knowledge OS', status: 'Active', progress: 45, tags: ['astro', 'tailwind'] },
];

const stats = {
  findings: 42,
  projects: 7,
  websites: 12,
  thisWeek: 3
};
---

<div class="space-y-12">
  {/* Hero */}
  <div class="text-center py-16">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/30 text-accent text-sm font-mono mb-6">
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      PERSONAL KNOWLEDGE OS
    </div>
    <h1 class="text-5xl md:text-7xl font-bold text-primary mb-6 tracking-tight">
      NEXUS
    </h1>
    <p class="text-xl text-secondary max-w-2xl mx-auto mb-8">
      Capture what you discover. Connect what you know.
    </p>
    <div class="max-w-md mx-auto">
      <input type="text" placeholder="Search your knowledge..." class="input w-full text-base" />
    </div>
  </div>

  {/* Stats */}
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="card text-center">
      <div class="stat-value">{stats.findings}</div>
      <div class="stat-label">Findings</div>
    </div>
    <div class="card text-center">
      <div class="stat-value">{stats.projects}</div>
      <div class="stat-label">Projects</div>
    </div>
    <div class="card text-center">
      <div class="stat-value">{stats.websites}</div>
      <div class="stat-label">Websites</div>
    </div>
    <div class="card text-center">
      <div class="stat-value">{stats.thisWeek}</div>
      <div class="stat-label">This Week</div>
    </div>
  </div>

  {/* Recent Discoveries */}
  <div>
    <h2 class="section-title flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      Recent Discoveries
    </h2>
    <div class="grid gap-4">
      {findings.map(f => (
        <a href={`/findings/${f.title.toLowerCase().replace(/\s+/g, '-')}`} class="card hover:border-accent/30 transition-all">
          <div class="flex items-start justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="tag accent">{f.category}</span>
                <span class="text-xs text-muted font-mono">{f.date}</span>
              </div>
              <h3 class="text-lg font-semibold text-primary mb-1">{f.title}</h3>
              <div class="flex flex-wrap gap-2 mt-2">
                {f.tags.map(t => <span class="tag">#{t}</span>)}
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>

  {/* Today */}
  <div>
    <h2 class="section-title flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Today
    </h2>
    <div class="card">
      <div class="space-y-4">
        <div class="flex gap-4">
          <span class="text-muted font-mono text-sm">08:42</span>
          <div class="flex-1">
            <div class="text-primary">AI tool discovered</div>
            <div class="text-secondary text-sm">OpenAI GPT-4o Mini release</div>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="text-muted font-mono text-sm">10:15</span>
          <div class="flex-1">
            <div class="text-primary">GitHub project saved</div>
            <div class="text-secondary text-sm">NEXUS knowledge system</div>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="text-muted font-mono text-sm">12:37</span>
          <div class="flex-1">
            <div class="text-primary">Design reference saved</div>
            <div class="text-secondary text-sm">Apple × Cyberpunk aesthetic</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Projects */}
  <div>
    <h2 class="section-title flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
      </svg>
      Active Projects
    </h2>
    <div class="grid md:grid-cols-2 gap-4">
      {projects.map(p => (
        <div class="card">
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-semibold text-primary">{p.title}</h3>
            <span class="tag accent text-xs">{p.status}</span>
          </div>
          <div class="w-full bg-surface-secondary rounded-full h-2 mb-2">
            <div class="bg-accent h-2 rounded-full" style={{ width: `${p.progress}%` }}></div>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-muted">{p.progress}% complete</span>
            <div class="flex gap-2">
              {p.tags.map(t => <span class="tag text-xs">#{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
