---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFindings } from '../lib/collections/findings';
import type { Finding } from '../lib/collections/findings';
const findings = getFindings();
const latest = findings.slice(0, 6);
const categories = [...new Set(findings.map(f => f.category))];
---

<BaseLayout>
  <div class="max-w-7xl mx-auto px-6 py-12">
    {/* Hero Section */}
    <div class="text-center mb-20 space-y-8">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 text-accent text-sm font-mono">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        Knowledge Base v1.0
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold text-primary tracking-tight">
        Your Second
        <span class="bg-gradient-to-r from-accent to-violet-400 bg-clip-text text-transparent"> Brain</span>
      </h1>
      
      <p class="text-xl md:text-2xl text-secondary max-w-3xl mx-auto leading-relaxed">
        A curated knowledge base for discoveries worth remembering. Track tools, insights, and ideas across your journey.
      </p>
      
      <div class="flex flex-wrap justify-center gap-4 pt-4">
        <a href="/nexus/findings" class="group inline-flex items-center gap-3 px-8 py-4 bg-accent hover:bg-accent/90 text-primary font-semibold rounded-xl transition-all duration-200 hover:scale-105 hover:shadow-xl hover:shadow-accent/20">
          Explore Findings
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="#latest" class="inline-flex items-center gap-2 px-8 py-4 border border-white/10 hover:bg-white/5 text-primary font-semibold rounded-xl transition-all duration-200 hover:scale-105">
          Browse Archive
        </a>
      </div>
      
      {/* Stats */}
      <div class="grid grid-cols-3 gap-8 max-w-lg mx-auto pt-12">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">{findings.length}</div>
          <div class="text-sm text-muted">Findings</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">{categories.length}</div>
          <div class="text-sm text-muted">Categories</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">2026</div>
          <div class="text-sm text-muted">Active</div>
        </div>
      </div>
    </div>

    {/* Categories */}
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-primary">Categories</h2>
        <a href="/nexus/findings" class="text-sm text-accent hover:underline">View all</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {categories.map((cat: string, idx: number) => {
          const colors = ['from-cyan-500 to-blue-600', 'from-purple-500 to-violet-600', 'from-emerald-500 to-teal-600'];
          const catCount = findings.filter(f => f.category === cat).length;
          return (
            <a href={`/nexus/findings?category=${encodeURIComponent(cat)}`} 
               class="group p-6 rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl hover:border-white/20 transition-all duration-300 hover:scale-105">
              <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${colors[idx % colors.length]} mb-4 group-hover:scale-110 transition-transform`}></div>
              <div class="text-lg font-semibold text-primary mb-1">{cat}</div>
              <div class="text-sm text-muted">{catCount} {catCount === 1 ? 'finding' : 'findings'}</div>
            </a>
          );
        })}
      </div>
    </section>

    {/* Latest Findings */}
    <section id="latest" class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-primary">Latest Findings</h2>
        <a href="/nexus/findings" class="text-sm text-accent hover:underline">View all</a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latest.map((f: Finding) => {
          const categoryColors = {
            'AI': 'from-purple-500 to-violet-600',
            'Tools': 'from-cyan-500 to-blue-600',
            'Projects': 'from-emerald-500 to-teal-600',
          };
          const categoryBg = {
            'AI': 'bg-purple-500/10 text-purple-400 border-purple-500/20',
            'Tools': 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
            'Projects': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
          };
          return (
            <a href={`/nexus/findings/${f.slug}`} 
               class="group p-6 rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl hover:border-white/20 transition-all duration-300 hover:scale-105">
              <div class="flex items-start justify-between mb-4">
                <span class={`px-3 py-1 rounded-full text-xs font-semibold border ${categoryBg[f.category]}`}>
                  {f.category}
                </span>
                <span class="text-xs text-muted font-mono">{f.date}</span>
              </div>
              <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition-colors">{f.title}</h3>
              <p class="text-sm text-secondary line-clamp-2">{f.description}</p>
              <div class="flex flex-wrap gap-2 mt-4">
                {f.tags.slice(0, 3).map((tag: string) => (
                  <span class="text-xs px-2 py-1 rounded-md bg-white/5 text-muted">{tag}</span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </section>

    {/* Quick Links */}
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/nexus/findings" class="p-6 rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl hover:border-accent/30 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-primary mb-2">Search Findings</h3>
        <p class="text-sm text-secondary">Browse through {findings.length} curated discoveries</p>
      </a>
      
      <a href="/nexus/roadmap" class="p-6 rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl hover:border-accent/30 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-violet-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-primary mb-2">Roadmap</h3>
        <p class="text-sm text-secondary">Track upcoming features and improvements</p>
      </a>
      
      <a href="/nexus/about" class="p-6 rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl hover:border-accent/30 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-primary mb-2">About</h3>
        <p class="text-sm text-secondary">Learn about Nexus and how to contribute</p>
      </a>
    </section>
  </div>
</BaseLayout>