---
import { getFindings } from '../lib/collections/findings';
import type { Finding } from '../lib/collections/findings';
const findings = getFindings();
const stats = {
  findings: findings.length,
  projects: 7,
  websites: 12,
  thisWeek: findings.filter(f => {
    const date = new Date(f.date);
    const weekAgo = new Date();
    weekAgo.setDate(weekAgo.getDate() - 7);
    return date >= weekAgo;
  }).length
};
---

<div class="space-y-12">
  {/* Hero */}
  <div class="text-center py-16">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/30 text-accent text-sm font-mono mb-6">
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      PERSONAL KNOWLEDGE OS
    </div>
    <h1 class="text-5xl md:text-7xl font-bold text-primary mb-6 tracking-tight">
      NEXUS
    </h1>
    <p class="text-xl text-secondary max-w-2xl mx-auto mb-8">
      Capture what you discover. Connect what you know.
    </p>
    <div class="max-w-md mx-auto">
      <input type="text" placeholder="Search your knowledge..." class="input w-full text-base" />
    </div>
  </div>

  {/* Stats */}
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="card text-center">
      <div class="stat-value">{stats.findings}</div>
      <div class="stat-label">Findings</div>
    </div>
    <div class="card text-center">
      <div class="stat-value">{stats.projects}</div>
      <div class="stat-label">Projects</div>
    </div>
    <div class="card text-center">
      <div class="stat-value">{stats.websites}</div>
      <div class="stat-label">Websites</div>
    </div>
    <div class="card text-center">
      <div class="stat-value">{stats.thisWeek}</div>
      <div class="stat-label">This Week</div>
    </div>
  </div>

  {/* Recent Discoveries */}
  <div>
    <h2 class="section-title flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      Recent Discoveries
    </h2>
    <div class="grid gap-4">
      {findings.slice(0, 3).map((finding: Finding) => (
        <a href={`https://minjarul1.github.io/nexus/findings/${finding.slug}`} class="card hover:border-accent/30 transition-all">
          <div class="flex items-start justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="tag accent">{finding.category}</span>
                <span class="text-xs text-muted font-mono">{finding.date}</span>
              </div>
              <h3 class="text-lg font-semibold text-primary mb-1">{finding.title}</h3>
              <div class="flex flex-wrap gap-2 mt-2">
                {finding.tags.slice(0, 3).map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>

  {/* Today */}
  <div>
    <h2 class="section-title flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Today
    </h2>
    <div class="card">
      <div class="space-y-4">
        <div class="flex gap-4">
          <span class="text-muted font-mono text-sm">08:42</span>
          <div class="flex-1">
            <div class="text-primary">Added FileSync finding</div>
            <div class="text-secondary text-sm">New tool discovered</div>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="text-muted font-mono text-sm">10:15</span>
          <div class="flex-1">
            <div class="text-primary">GitHub project updated</div>
            <div class="text-secondary text-sm">NEXUS knowledge system</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Projects */}
  <div>
    <h2 class="section-title flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
      </svg>
      Active Projects
    </h2>
    <div class="grid md:grid-cols-2 gap-4">
      <div class="card">
        <div class="flex items-start justify-between mb-3">
          <h3 class="font-semibold text-primary">NEXUS - Personal Knowledge OS</h3>
          <span class="tag accent text-xs">Active</span>
        </div>
        <div class="w-full bg-surface-secondary rounded-full h-2 mb-2">
          <div class="bg-accent h-2 rounded-full" style="width: 45%"></div>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-muted">45% complete</span>
          <div class="flex gap-2">
            <span class="tag text-xs">#astro</span>
            <span class="tag text-xs">#tailwind</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
