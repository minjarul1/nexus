  <div class="grid md:grid-cols-2 gap-4">
    <a href="#" class="card block hover:border-accent/30">
      <div class="flex items-start justify-between mb-4">
        <span class="tag accent">Development</span>
        <span class="tag text-green-400 bg-green-400/10 border-green-400/30">Active</span>
