---
layout: '../layouts/BaseLayout.astro'
title: "Findings"
---

---
const allFindings = [
  { slug: 'openai-gpt4o-mini', title: 'OpenAI GPT-4o Mini', category: 'AI', date: '2026-09-16', tags: ['ai', 'openai', 'multimodal'], importance: 'high' },
  { slug: 'local-ai-ollama', title: 'Local AI with Ollama', category: 'AI', date: '2026-09-15', tags: ['ai', 'local', 'ollama'], importance: 'high' },
];

const categories = ['All', 'AI', 'Design', 'Development', 'Tools'];
const activeCategory = 'All';
---

<div class="space-y-6">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <h1 class="text-3xl font-bold text-primary">Findings</h1>
    <div class="flex gap-2">
      <input type="text" placeholder="Search findings..." class="input" style={{ maxWidth: '300px' }} />
    </div>
  </div>

  {/* Filters */}
  <div class="flex flex-wrap gap-2">
    {categories.map(cat => (
      <button class:list={['tag', activeCategory === cat ? 'tag-accent' : '']}>
        {cat}
      </button>
    ))}
  </div>

  {/* Findings List */}
  <div class="space-y-4">
    {allFindings.map(f => (
      <a href={`/findings/${f.slug}`} class="card block hover:border-accent/30">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="tag accent">{f.category}</span>
              {f.importance === 'high' && (
                <span class="tag" title="Important">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                  Important
                </span>
              )}
              <span class="text-xs text-muted font-mono ml-auto">{f.date}</span>
            </div>
            <h2 class="text-xl font-semibold text-primary mb-2">{f.title}</h2>
            <div class="flex flex-wrap gap-2">
              {f.tags.map(t => <span class="tag">#{t}</span>)}
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-muted flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</div>
