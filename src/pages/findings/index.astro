---
import { getFindings, getCategories, getPlatforms } from '../../lib/collections/findings';
import type { Finding } from '../../lib/collections/findings';
const findings = getFindings();
const categories = getCategories();
const platforms = getPlatforms();
---

<div class="max-w-7xl mx-auto px-6 py-12">
  {/* Header */}
  <div class="flex flex-col md:flex-row md:items-center justify-between mb-12 gap-6">
    <div>
      <h1 class="text-4xl font-bold text-primary mb-2">Findings</h1>
      <p class="text-secondary">{findings.length} discoveries tracked</p>
    </div>
    
    <div class="flex flex-wrap gap-3">
      <select id="category-filter" class="px-4 py-2 rounded-xl bg-surface-carbon/50 border border-white/10 text-primary focus:border-accent focus:outline-none">
        <option value="">All Categories</option>
        {categories.map((cat: string) => (
          <option value={cat}>{cat}</option>
        ))}
      </select>
      <select id="platform-filter" class="px-4 py-2 rounded-xl bg-surface-carbon/50 border border-white/10 text-primary focus:border-accent focus:outline-none">
        <option value="">All Platforms</option>
        {platforms.map((plat: string) => (
          <option value={plat}>{plat}</option>
        ))}
      </select>
      <input type="text" id="search-filter" placeholder="Search..." 
             class="px-4 py-2 rounded-xl bg-surface-carbon/50 border border-white/10 text-primary focus:border-accent focus:outline-none w-48" />
    </div>
  </div>

  {/* Findings Grid */}
  <div id="findings-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {findings.map((f: Finding) => {
      const categoryColors = {
        'AI': 'from-purple-500 to-violet-600',
        'Tools': 'from-cyan-500 to-blue-600',
        'Projects': 'from-emerald-500 to-teal-600',
      };
      const categoryBg = {
        'AI': 'bg-purple-500/10 text-purple-400 border-purple-500/20',
        'Tools': 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
        'Projects': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
      };
      return (
        <a href={`/nexus/findings/${f.slug}`} 
           class="group p-6 rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl hover:border-white/20 transition-all duration-300 hover:scale-105">
          <div class="flex items-start justify-between mb-4">
            <span class={`px-3 py-1 rounded-full text-xs font-semibold border ${categoryBg[f.category]}`}>
              {f.category}
            </span>
            <span class="text-xs text-muted font-mono">{f.date}</span>
          </div>
          <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition-colors">{f.title}</h3>
          <p class="text-sm text-secondary mb-4 line-clamp-2">{f.description}</p>
          <div class="flex items-center justify-between">
            <div class="flex flex-wrap gap-1">
              {f.tags.slice(0, 2).map((tag: string) => (
                <span class="text-xs px-2 py-1 rounded-md bg-white/5 text-muted">{tag}</span>
              ))}
              {f.tags.length > 2 && <span class="text-xs text-muted">+{f.tags.length - 2}</span>}
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-muted group-hover:text-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      );
    })}
  </div>

  {/* Empty State */}
  <div id="empty-state" class="hidden text-center py-20">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h3 class="text-xl font-semibold text-primary mb-2">No findings found</h3>
    <p class="text-secondary">Try adjusting your filters</p>
  </div>
</div>

<script>
  // Filter functionality
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
  const platformFilter = document.getElementById('platform-filter') as HTMLSelectElement;
  const searchFilter = document.getElementById('search-filter') as HTMLInputElement;
  const grid = document.getElementById('findings-grid');
  const emptyState = document.getElementById('empty-state');

  const findings = [
    { category: "AI", platform: "Cross-platform", title: "OpenAI GPT-4o Mini", description: "A cost-efficient multimodal model...", tags: ["ai", "openai", "multimodal"], slug: "openai-gpt4o-mini" },
    { category: "AI", platform: "Cross-platform", title: "Local AI with Ollama", description: "Run AI models locally...", tags: ["ai", "local", "ollama"], slug: "local-ai-ollama" },
    { category: "Tools", platform: "macOS", title: "Pearcleaner", description: "macOS app cleaner...", tags: ["macos", "cleaner"], slug: "pearcleaner" },
    { category: "AI", platform: "Web", title: "Claude.ai", description: "Anthropic's conversational AI...", tags: ["ai", "claude"], slug: "claude" },
  ];

  function filterFindings() {
    const category = categoryFilter.value;
    const platform = platformFilter.value;
    const search = searchFilter.value.toLowerCase();
    
    const filtered = findings.filter(f => {
      return (!category || f.category === category) &&
             (!platform || f.platform === platform) &&
             (!search || f.title.toLowerCase().includes(search) || f.tags.some(t => t.includes(search)));
    });

    // Update grid with filtered results
    if (grid && emptyState) {
      if (filtered.length === 0) {
        grid.classList.add('hidden');
        emptyState.classList.remove('hidden');
      } else {
        grid.classList.remove('hidden');
        emptyState.classList.add('hidden');
      }
    }
  }

  categoryFilter?.addEventListener('change', filterFindings);
  platformFilter?.addEventListener('change', filterFindings);
  searchFilter?.addEventListener('input', filterFindings);
</script>