---
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'NEXUS - Personal Discovery & Knowledge OS' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | NEXUS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <style>
      * { border-color: rgba(255,255,255,0.08); }
      body { background: #07090D; color: #F5F7FA; font-family: 'Inter', system-ui, sans-serif; }
      ::selection { background: rgba(0,229,255,0.2); color: #00E5FF; }
      
      .grid-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.03;
        background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px);
        background-size: 40px 40px;
        z-index: 0;
      }
      
      .main-content { margin-left: 260px; min-height: 100vh; position: relative; z-index: 1; }
      @media (max-width: 768px) { .main-content { margin-left: 0; } }
      
      .card { background: #0D1117; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 24px; transition: all 0.2s; }
      .card:hover { border-color: rgba(255,255,255,0.2); box-shadow: 0 4px 24px rgba(0,0,0,0.4); }
      
      .btn-primary { background: #00E5FF; color: #07090D; padding: 12px 24px; border-radius: 12px; font-weight: 500; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
      .btn-primary:hover { background: #00d4e6; }
      
      .btn-secondary { background: transparent; border: 1px solid rgba(255,255,255,0.2); color: #F5F7FA; padding: 12px 24px; border-radius: 12px; font-weight: 500; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
      .btn-secondary:hover { border-color: rgba(255,255,255,0.4); }
      
      .tag { display: inline-flex; align-items: center; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-family: 'JetBrains Mono', monospace; background: #111720; border: 1px solid rgba(255,255,255,0.1); color: #8B95A5; }
      .tag.accent { background: rgba(0,229,255,0.1); border-color: rgba(0,229,255,0.3); color: #00E5FF; }
      
      .input { background: #0D1117; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px 16px; color: #F5F7FA; outline: none; transition: all 0.2s; }
      .input:focus { border-color: rgba(0,229,255,0.5); box-shadow: 0 0 0 1px rgba(0,229,255,0.5); }
      .input::placeholder { color: #5F6875; }
      
      .nav-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 12px; color: #8B95A5; transition: all 0.2s; }
      .nav-item:hover { color: #F5F7FA; background: rgba(255,255,255,0.05); }
      .nav-item.active { color: #F5F7FA; background: rgba(255,255,255,0.1); }
    </style>
  </head>
  <body>
    <div class="grid-bg"></div>
    {@render Sidebar()}
    <div class="main-content">
      {@render Header()}
      <main class="px-6 py-8 max-w-7xl mx-auto">
        <slot />
      </main>
    </div>
  </body>
</html>
