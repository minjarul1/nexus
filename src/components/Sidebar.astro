---
const navItems = [
  { href: '/nexus/', label: 'Home', section: 'discover' },
  { href: '/nexus/findings', label: 'Findings', section: 'discover' },
  { href: '/nexus/today', label: 'Today', section: 'discover' },
  { href: '/nexus/important', label: 'Important', section: 'discover' },
  { href: '/nexus/library', label: 'Websites', section: 'library' },
  { href: '/nexus/library?cat=tools', label: 'Tools', section: 'library' },
  { href: '/nexus/library?cat=articles', label: 'Articles', section: 'library' },
  { href: '/nexus/projects', label: 'Projects', section: 'workspace' },
  { href: '/nexus/ideas', label: 'Ideas', section: 'workspace' },
];
const currentPage = Astro.url.pathname;
---

<nav class="sidebar" aria-label="Main navigation">
  {/* Logo Area */}
  <div class="sidebar-header p-6 border-b border-white/10">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/30 flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <div class="min-w-0">
        <h1 class="font-semibold text-primary text-sm tracking-wider">NEXUS</h1>
        <p class="text-xs text-muted font-mono">KNOWLEDGE OS</p>
      </div>
    </div>
  </div>
  
  {/* Navigation */}
  <div class="flex-1 overflow-y-auto py-4">
    <div class="px-3 mb-2">
      <p class="technical text-muted px-3 mb-2">DISCOVER</p>
    </div>
    
    <div class="space-y-1 px-2">
      {navItems.map(item => {
        const isActive = currentPage === item.href || (item.href !== '/nexus/' && currentPage.startsWith(item.href));
        return (
          <a 
            href={item.href} 
            class={`nav-item ${isActive ? 'active' : ''}`}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="nav-indicator"></span>
            <span class="text-sm font-medium">{item.label}</span>
          </a>
        );
      })}
    </div>
    
    {/* Bottom Status */}
    <div class="mt-auto pt-4 px-3 border-t border-white/10">
      <div class="flex items-center gap-2 text-xs font-mono text-muted">
        <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
        <span>SYSTEM ONLINE</span>
      </div>
      <div class="mt-2 technical text-muted">
        {6} NODES
      </div>
    </div>
  </div>
</nav>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 260px;
    height: 100vh;
    background: var(--surface-carbon);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    z-index: 50;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  
  .sidebar-header {
    flex-shrink: 0;
  }
  
  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: all 0.12s;
    text-decoration: none;
    position: relative;
    cursor: pointer;
  }
  
  .nav-item:hover {
    color: var(--text-primary);
    background: rgba(255,255,255,0.04);
  }
  
  .nav-item.active {
    color: var(--text-primary);
    background: rgba(0,229,255,0.08);
    border: 1px solid rgba(0,229,255,0.18);
  }
  
  .nav-indicator {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 20px;
    background: var(--accent-cyan);
    border-radius: 0 2px 2px 0;
  }
  
  .technical {
    font-size: 11px;
    letter-spacing: 0.08em;
    font-family: 'JetBrains Mono', monospace;
  }
  
  @media (max-width: 1024px) {
    .sidebar {
      transform: translateX(-100%);
    }
    
    .sidebar.open {
      transform: translateX(0);
    }
  }
</style>
