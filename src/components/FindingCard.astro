---
interface Props {
  title: string;
  description: string;
  category: string;
  platform: string;
  date: string;
  slug: string;
  tags: string[];
  website: string;
  features?: string[];
  content?: string[];
  id?: string;
}

const { 
  title, 
  description, 
  category, 
  platform, 
  date, 
  slug, 
  tags, 
  website,
  features = [],
  content = [],
  id = 'NX-000'
} = Astro.props;

const domain = website.includes('github.com') 
  ? new URL(website).hostname.replace('www.', '')
  : new URL(website).hostname.replace('www.', '').split('.')[0];

const faviconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;
const logoUrl = website.includes('github.com')
  ? `https://github.com/${domain}.png?size=128`
  : faviconUrl;

const categoryColors: Record<string, string> = {
  'AI': 'from-purple-500 to-violet-600',
  'Tools': 'from-cyan-500 to-blue-600',
  'Projects': 'from-emerald-500 to-teal-600',
};

const categoryBg: Record<string, string> = {
  'AI': 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  'Tools': 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
  'Projects': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
};

const getCategoryIcon = (cat: string) => {
  switch(cat) {
    case 'AI': return '🤖';
    case 'Tools': return '⚡';
    case 'Projects': return '📁';
    default: return '🔍';
  }
};
---

<div class="max-w-4xl mx-auto space-y-8">
  {/* Back Button */}
  <a href="/nexus/findings" class="inline-flex items-center gap-2 text-sm text-muted hover:text-accent transition-all duration-300 group">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Findings
  </a>

  {/* Hero Section */}
  <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl">
    {/* Background Glow */}
    <div class={`absolute top-0 left-1/2 -translate-x-1/2 w-96 h-32 bg-gradient-to-r ${categoryColors[category] || 'from-cyan-500 to-blue-500'} opacity-20 blur-3xl`}></div>
    
    <div class="relative p-8">
      {/* Logo & Title Row */}
      <div class="flex items-start gap-6 mb-6">
        {/* App Logo */}
        <div class="relative flex-shrink-0">
          <div class={`w-20 h-20 rounded-2xl bg-gradient-to-br ${categoryColors[category] || 'from-cyan-500 to-blue-500'} p-0.5 shadow-2xl`}>
            <div class="w-full h-full rounded-xl bg-surface-carbon flex items-center justify-center overflow-hidden">
              {website.includes('github.com') ? (
                <img src={`https://github.com/${domain}.png?size=64`} alt={title} class="w-12 h-12 rounded-lg" loading="lazy" />
              ) : (
                <img src={faviconUrl} alt={title} class="w-12 h-12 rounded-lg object-contain" loading="lazy" />
              )}
            </div>
          </div>
          <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-success border-2 border-surface-carbon"></div>
        </div>
        
        {/* Title Info */}
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-3 mb-2 flex-wrap">
            <span class={`px-3 py-1 rounded-full text-xs font-semibold border ${categoryBg[category] || categoryBg['Tools']}`}>
              {getCategoryIcon(category)} {category}
            </span>
            <span class={`px-3 py-1 rounded-full text-xs font-medium border ${categoryBg['Tools']}`}>
              {platform}
            </span>
            <span class="text-xs text-muted font-mono">{date}</span>
          </div>
          <h1 class="text-4xl font-bold text-primary mb-3">{title}</h1>
          <p class="text-lg text-secondary leading-relaxed">{description}</p>
        </div>
      </div>

      {/* Action Buttons */}
      <div class="flex flex-wrap gap-3 pt-6 border-t border-white/10">
        <a href={website} target="_blank" rel="noopener noreferrer" 
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent/10 hover:bg-accent/20 border border-accent/30 rounded-lg text-accent font-medium transition-all duration-200 hover:scale-105 hover:shadow-lg hover:shadow-accent/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Visit Website
        </a>
        {website.includes('github.com') && (
          <a href={website} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-5 py-2.5 hover:bg-white/5 border border-white/10 rounded-lg text-primary font-medium transition-all duration-200 hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View Source
          </a>
        )}
      </div>
    </div>
  </div>

  {/* Stats Bar */}
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="p-4 rounded-xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl">
      <div class="text-xs text-muted font-mono mb-1">CATEGORY</div>
      <div class="text-sm font-semibold text-primary">{category}</div>
    </div>
    <div class="p-4 rounded-xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl">
      <div class="text-xs text-muted font-mono mb-1">PLATFORM</div>
      <div class="text-sm font-semibold text-primary">{platform}</div>
    </div>
    <div class="p-4 rounded-xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl">
      <div class="text-xs text-muted font-mono mb-1">DATE</div>
      <div class="text-sm font-semibold text-primary">{date}</div>
    </div>
    <div class="p-4 rounded-xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl">
      <div class="text-xs text-muted font-mono mb-1">REFERENCE</div>
      <div class="text-sm font-semibold text-accent">{id}</div>
    </div>
  </div>

  {/* Features Section */}
  {features.length > 0 && (
    <div class="p-6 rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl">
      <h2 class="text-xl font-semibold text-primary mb-6 flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </span>
        Key Features
      </h2>
      <ul class="space-y-3">
        {features.map((feature: string, idx: number) => (
          <li class="flex items-start gap-3 p-3 rounded-lg hover:bg-white/5 transition-colors group">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-bold flex items-center justify-center group-hover:bg-accent/20 transition-colors">
              {idx + 1}
            </span>
            <span class="text-secondary leading-relaxed">{feature}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {/* Content Section */}
  {content.length > 0 && (
    <div class="p-6 rounded-2xl border border-white/10 bg-surface-carbon/50 backdrop-blur-xl">
      <h2 class="text-xl font-semibold text-primary mb-6 flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-violet-500/10 flex items-center justify-center text-violet-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </span>
        Details
      </h2>
      <div class="space-y-4">
        {content.map((paragraph: string, idx: number) => (
          <p class="text-secondary leading-relaxed">{paragraph}</p>
        ))}
      </div>
    </div>
  )}

  {/* Tags */}
  <div class="flex flex-wrap gap-2 pt-4">
    {tags.map((tag: string) => (
      <span class="px-4 py-2 rounded-full text-sm font-mono bg-white/5 text-muted border border-white/10 hover:border-accent/30 hover:text-accent transition-all duration-200 cursor-default">
        #{tag}
      </span>
    ))}
  </div>
</div>

{/* Theme Toggle Button */}
<button
  id="theme-toggle"
  class="theme-toggle fixed bottom-6 right-6 z-50"
  aria-label="Toggle theme"
  title="Toggle dark/light theme"
>
  <svg class="icon-sun w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <svg class="icon-moon w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  // Theme initialization
  const savedTheme = localStorage.getItem('nexus-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', savedTheme);
  if (savedTheme === 'light') {
    document.documentElement.classList.add('light');
    document.documentElement.classList.remove('dark');
  } else {
    document.documentElement.classList.add('dark');
    document.documentElement.classList.remove('light');
  }

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('nexus-theme', next);
    });
  }
</script>

<style>
  @keyframes pulse-glow {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.8; }
  }
  .finding-hero:hover .pulse-glow {
    animation: pulse-glow 2s ease-in-out infinite;
  }

  /* Theme Toggle */
  .theme-toggle {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(13,17,23,0.9);
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.12s;
    backdrop-filter: blur(12px);
  }
  .theme-toggle:hover {
    border-color: rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.06);
    color: var(--text-primary);
  }
  [data-theme="light"] .theme-toggle {
    background: rgba(255,255,255,0.9);
    border-color: rgba(0,0,0,0.1);
  }
  [data-theme="light"] .theme-toggle:hover {
    background: rgba(255,255,255,1);
  }
  [data-theme="light"] .theme-toggle .icon-moon,
  [data-theme="dark"] .theme-toggle .icon-sun { display: none; }
  [data-theme="light"] .theme-toggle .icon-sun { display: flex; }

  /* Light Theme Overrides */
  [data-theme="light"] .theme-toggle {
    background: rgba(255,255,255,0.95);
    border-color: rgba(0,0,0,0.1);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
</style>
